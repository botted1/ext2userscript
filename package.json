{
  "name": "ext2userscript",
  "version": "0.0.0",
  "description": "Convert browser extensions into userscripts for Tampermonkey and Violentmonkey",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/unit/**/*.test.ts\"",
    "test:browser": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/browser/**/*.test.ts\"",
    "test:file": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1",
    "script": "node --experimental-strip-types --disable-warning=ExperimentalWarning",
    "cli": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc -p .",
    "web": "node --experimental-strip-types --disable-warning=ExperimentalWarning web/build.ts",
    "bench": "node --experimental-strip-types --disable-warning=ExperimentalWarning bench/run.ts",
    "bench:pin":"node --experimental-strip-types --disable-warning=ExperimentalWarning bench/pin.ts",
    "bench:setup":"node --experimental-strip-types --disable-warning=ExperimentalWarning bench/real/setup.ts"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.64.0",
    "typescript": "7.0.2"
  }
}
